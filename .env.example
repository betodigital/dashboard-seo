# ── Copie este arquivo para .env e preencha os valores ────────────

# Django
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
DEBUG=False
ALLOWED_HOSTS=seudominio.com,www.seudominio.com

# CSRF — coloque o domínio exato com protocolo
CSRF_TRUSTED_ORIGINS=https://seudominio.com,https://www.seudominio.com

# Banco de dados PostgreSQL
DB_NAME=django_app
DB_USER=postgres
DB_PASSWORD=senha-forte-aqui
DB_HOST=db
DB_PORT=5432

# Gunicorn (opcional)
GUNICORN_WORKERS=3
